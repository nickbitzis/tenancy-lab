# Signing key for tenant tokens. Any long random string. Unset means a random key per process.
TENANCYLAB_SECRET=change-me-to-a-long-random-string
# Key for the admin mutation endpoints (X-Admin-Key header).
TENANCYLAB_ADMIN_KEY=change-me-too
# Set to 1 to turn on the planted pooled search bug the red team must catch.
TENANCYLAB_PLANTED_BUG=0
